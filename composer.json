{
    "name": "cockpit-hq/cockpit",
    "type": "project",
    "description": "Cockpit Content Platform",
    "keywords": [
        "cms",
        "headless",
        "api",
        "cockpit"
    ],
    "homepage": "https://getcockpit.com/",
    "license": "MIT",
    "authors": [
        {
            "name": "Artur Heinze",
            "email": "artur@agentejo.com"
        }
    ],
    "scripts": {
        "pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices",
        "post-install-cmd": "@php scripts/vendor-patches.php",
        "post-update-cmd": "@php scripts/vendor-patches.php",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8080 index.php"
        ],
        "git-pull-all-rebase": "find . -type d -name .git -execdir sh -c 'echo \"\\n=== $(basename $(pwd)) ===\"; git pull --rebase' \\;"
    },
    "require": {
        "php": "^8.3.0",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-zip": "*",
        "phpmailer/phpmailer": "^6.4",
        "guzzlehttp/guzzle": "^7.4.5",
        "claviska/simpleimage": "^4.0",
        "ksubileau/color-thief-php": "^3.0",
        "league/flysystem": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "firebase/php-jwt": "^7.0",
        "mongodb/mongodb": "^2.0.0",
        "maennchen/zipstream-php": "^3.1.0",
        "colinodell/json5": "^2.2",
        "robthree/twofactorauth": "^3.0",
        "bacon/bacon-qr-code": "^3.0",
        "symfony/polyfill-mbstring": "^1.22",
        "symfony/polyfill-php84": "^1.30",
        "symfony/polyfill-php85": "^1.33",
        "webonyx/graphql-php": "^15.0",
        "zircote/swagger-php": "^5.0",
        "symfony/console": "^6.4",
        "symfony/process": "^6.2",
        "jumbojett/openid-connect-php": "^1.0.2"
    },
    "config": {
        "vendor-dir": "lib/vendor",
        "optimize-autoloader": true,
        "prefer-dist": true,
        "lock": false,
        "ignore-platform-reqs": true,
        "no-dev": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "autoload": {
        "classmap": [
            "lib/"
        ]
    },
    "extra": {
        "aws/aws-sdk-php": [
            "S3"
        ]
    }
}
